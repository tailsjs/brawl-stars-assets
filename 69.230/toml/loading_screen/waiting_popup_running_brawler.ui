id = "waiting_popup_running_brawler"
priority = 1

type = "UiWidget"
subtype = "GenericHeroArea"

sc_file_source = "ClientFile"
sc_file = "sc/shop.sc"
export_name = "offer_item_brawler_big"

hide_binding=[ "hero_ph" ]

hide=[ "brawler_level", ]

move = [ { path="hero_area", scale=[1.0, 1.0] }, { path="", scale=[1.0, 1.0] } ]

[skins]
# "Profile"
skin  = { binding="hero_ph", animation="WALK", animation_next="WALK", rotation=75.0, position=[0,-7.0,0], offset=[  0, 100] }
buddy = { binding="hero_ph", animation="WALK", animation_next="WALK", rotation=75.0, position=[0,-7.0,0], offset=[-150, 110] }

# More face
#skin  = { binding="hero_ph", animation="WALK", animation_next="WALK", rotation=55.0, position=[0,-7.0,0], offset=[  0, 100] }
#buddy = { binding="hero_ph", animation="WALK", animation_next="WALK", rotation=55.0, position=[0,-7.0,0], offset=[-50, 110] }

# Full side on
#skin  = { binding="hero_ph", animation="WALK", animation_next="WALK", rotation=90.0, position=[0,-7.0,0], offset=[  0, 100] }
#buddy = { binding="hero_ph", animation="WALK", animation_next="WALK", rotation=90.0, position=[0,-7.0,0], offset=[-50, 110] }

# Full side on with level camera
#skin  = { binding="hero_ph", animation="WALK", animation_next="WALK", rotation=90.0, position=[0,0.0,0], offset=[  0, 240] }
#buddy = { binding="hero_ph", animation="WALK", animation_next="WALK", rotation=90.0, position=[0,0.0,0], offset=[-50, 250] }

[bindings]
hero_area = { path="hero_area" }
hero_ph = { path="hero_area/hero_ph" }
title = { path="info_title" }
subtitle = { path="info_subtitle" }

[custom]

#bool.hide_spinner = true
#bool.behind_spinner = true
bool.happy_animation_only = false
#vector2.start = [-150.0, 0.0] # start neart the center
vector2.start = [10000.0, 0.0] # start at screen edge
#vector2.start = [0.0, -250.0] 

vector2.self_pos = [0.0, 120.0]
vector2.shadow_pos = [100, 240.0]
vector2.shadow_scale = [0.6, 0.6]

float.speed_x = 400.0
#float.speed_x = 0.0
float.fade_distance = 50.0
float.min_x = -650.0
float.max_x = 700.0

float.y_start = -200.0
float.y_travel = 0.0

bool.dvd_logo = false
float.min_y = -250.0
float.max_y = 300.0
float.speed_y = 200.0
float.fade_distance_y = 0.0

float.outline_thickness = 4.0
float.white_outline_thickness = 12.0

vector2.buddy_offset_TrickshotDude = [320,0]
vector2.buddy_offset_HammerDude = [320,-5]
vector2.buddy_offset_Cactus= [300, 0]
vector2.buddy_offset_Undertaker = [-80, -120]
vector2.buddy_offset_BowDude = [-20, -200]
