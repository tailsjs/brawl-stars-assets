id = "combat_numbers"
priority = 1

sc_file_source = "ClientFile"
sc_file = "sc/ui.sc"
export_name = "damage_number"

[custom.int]
damage_min = 500
damage_max = 5000
grouping_window_ticks = 4
grouping_max_angle_degrees = 180

[custom.float]
refresh_lifetime_fraction = 0.05
refresh_movement_fraction = 0.15
count_up_seconds = 0.07
update_pop_peak_multiplier = 1.15
update_pop_peak_seconds = 0.08
update_pop_settle_seconds = 0.12
crit_shake_delay_seconds = 0.0
crit_shake_seconds = 0.2
crit_shake_frequency_hz = 20.0
crit_shake_horizontal_amplitude = 5.0
crit_shake_vertical_amplitude = 2.0
size_min = 0.8
size_max = 1.3
crit_size_bonus = 0.1
lifetime_min_seconds = 0.8
lifetime_max_seconds = 1.0
crit_lifetime_bonus_seconds = 0.08
distance_min_multiplier = 0.50
distance_max_multiplier = 0.65
distance_random_fraction = 0.1
directional_end_distance = 75.0
movement_ease_exponent = 16.0
gravity_drop_min = 4
gravity_drop_max = 8
gravity_start_fraction = 0.3
upward_distance = 20.0
upward_health_bar_factor = 0.75
upward_offset_y = -45.0
upward_spacing = 15.0
directional_spacing = 10.0
spacing_reset_seconds = 0.5
initial_scale = 0.6
spawn_scale_seconds = 0.2
pop_peak_multiplier = 1.25
pop_peak_seconds = 0.105
pop_settle_seconds = 0.285
normal_pop_peak_multiplier = 1.12
normal_pop_peak_seconds = 0.105
normal_pop_settle_seconds = 0.285
fade_seconds = 0.3
viewport_padding = 12.0

[custom.bool]
crit_pop_enabled = true
normal_pop_enabled = false
clamp_to_viewport = true

[custom.string]
damage_curve = "inverse_quadratic"
healing_color = "FF22CC22"
friendly_damage_color = "FFF03F3F"
friendly_critical_color = "FFCC2222"
critical_color = "FFFFAA00"
damage_color = "FFEEEEEE"
