id = "buddy_shop_tab"
priority = 1

sc_file_source = "ClientFile"
sc_file = "sc/buddy_shop.sc"
export_name = "buddy_shop_tab"

set_text = [
	{ parent_binding="noti", path="txt_free", tid="TID_SHOP_FREE" },
	{ parent_binding="noti", path="txt_new", tid="TID_SHOP_OFFER_NEW" },
]

[bindings]
icon_1 = { parent_binding="gfx", path="brawler_icon_1/ph" }
icon_2 = { parent_binding="gfx", path="brawler_icon_2/ph" }
icon_3 = { parent_binding="gfx", path="brawler_icon_3/ph" }

icon_state_1 = { parent_binding="gfx", path="brawler_icon_1" }
icon_state_2 = { parent_binding="gfx", path="brawler_icon_2" }
icon_state_3 = { parent_binding="gfx", path="brawler_icon_3" }

gfx = { path="button_navi_shop" }
noti = { parent_binding="gfx", path="notification" }
noti_count = { parent_binding="gfx", path="count_txt" }

[animation]
selected = { binding="gfx", end="ready" }
unselected = { binding="gfx", end="idle" }

bling = { binding="noti", end="chromatic" } # TODO: More striking look for bling machine tabs
empty = { binding="noti", end="attention" } # TODO: More striking look for emptied machine tabs

new = { binding="noti", end="new" }

incomplete_1= { binding="icon_state_1", end="default" }
incomplete_2= { binding="icon_state_2", end="default" }
incomplete_3= { binding="icon_state_3", end="default" }

complete_1 = { binding="icon_state_1", end="complete" }
complete_2 = { binding="icon_state_2", end="complete" }
complete_3 = { binding="icon_state_3", end="complete" }

complete_bling_1 = { binding="icon_state_1", end="complete_bling" }
complete_bling_2 = { binding="icon_state_2", end="complete_bling" }
complete_bling_3 = { binding="icon_state_3", end="complete_bling" }

default_animation = { binding="icon_state_1", end="default", also_play=["incomplete_1", "incomplete_2", "incomplete_3", "unselected" ] }
